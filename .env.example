POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_PORT=5433

RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments

DATABASE_URL=postgresql+asyncpg://payments:payments@payment_db:5432/payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/
API_KEY=change-me-before-production
LOG_LEVEL=INFO

OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=100

CONSUMER_PREFETCH=16
CONSUMER_CONCURRENCY=8
MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0

WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT=5.0
WEBHOOK_BASE_DELAY=0.5

CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0

GATEWAY_MIN_DELAY=2.0
GATEWAY_MAX_DELAY=5.0
GATEWAY_SUCCESS_RATE=0.9
